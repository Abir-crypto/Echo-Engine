{
  "sourceLanguage": "en",
  "strings": {
    "Audio": {
      "comment": "Accessibility label of the audio badge on a project card."
    },
    "Cancel": {
      "comment": "Cancel button."
    },
    "Can’t import": {
      "comment": "Title of the import sheet when an import fails."
    },
    "Changes couldn’t be saved. Free up some space, then try again.": {
      "comment": "Editor error."
    },
    "Delete": {
      "comment": "Delete action for a project."
    },
    "Delete project": {
      "comment": "Destructive confirmation button."
    },
    "Delete “%@”?": {
      "comment": "Delete confirmation title. %@ = project title."
    },
    "Edited today": {
      "comment": "Project card date when the project changed today."
    },
    "Export": {
      "comment": "Editor toolbar button that opens the export sheet."
    },
    "Files": {
      "comment": "Import source: the Files app."
    },
    "Hold for original": {
      "comment": "Editor: press and hold to hear the original audio."
    },
    "Import a video or audio file, or record something new.": {
      "comment": "Empty projects screen."
    },
    "Import audio or video": {
      "comment": "Primary button on the projects screen."
    },
    "Importing": {
      "comment": "Title of the import progress sheet."
    },
    "It can’t be undone.": {
      "comment": "Delete confirmation message when the size is unknown."
    },
    "Need %@ more to edit this project. Free up space on your iPad, then come back. Your import is saved.": {
      "comment": "Editor blocked by storage on iPad (SPEC § 9). %@ = missing space."
    },
    "Need %@ more to edit this project. Free up space on your iPhone, then come back. Your import is saved.": {
      "comment": "Editor blocked by storage on iPhone (SPEC § 9). %@ = missing space."
    },
    "Needs %@ to edit": {
      "comment": "Project card warning. %@ = missing space, e.g. 0.2 GB (SPEC § 14.1, § 15)."
    },
    "Needs %@ to export": {
      "comment": "Project card warning. %@ = missing space, e.g. 0.2 GB (SPEC § 15)."
    },
    "OK": {
      "comment": "Dismisses an alert."
    },
    "Pause": {
      "comment": "Accessibility label of the pause button."
    },
    "Photos": {
      "comment": "Import source: the Photos library."
    },
    "Pinch to zoom": {
      "comment": "Caption on the editor waveform."
    },
    "Play": {
      "comment": "Accessibility label of the play button."
    },
    "Playhead": {
      "comment": "Accessibility label of the playhead on the overview strip."
    },
    "Preparing…": {
      "comment": "Import progress before copying starts."
    },
    "Projects": {
      "comment": "Tab bar item and title of the projects screen."
    },
    "Projects couldn’t be loaded. Restart Echo Engine to try again.": {
      "comment": "Error alert."
    },
    "Record": {
      "comment": "Tab bar item and title of the record screen."
    },
    "Redo": {
      "comment": "Accessibility label of the redo button."
    },
    "Rename": {
      "comment": "Rename action for a project."
    },
    "Rename project": {
      "comment": "Title of the rename dialog."
    },
    "Settings": {
      "comment": "Settings button and screen title."
    },
    "The import couldn’t finish. Try again.": {
      "comment": "Import error."
    },
    "The project couldn’t be deleted. Try again.": {
      "comment": "Error alert."
    },
    "The project couldn’t be renamed. Try again.": {
      "comment": "Error alert."
    },
    "The video couldn’t be loaded from Photos. Make sure it’s downloaded from iCloud, then try again.": {
      "comment": "Import error."
    },
