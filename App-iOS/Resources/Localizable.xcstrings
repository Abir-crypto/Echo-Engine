      "comment": "Title of the import progress sheet."
    },
    "It can’t be undone.": {
      "comment": "Delete confirmation message when the size is unknown."
    },
    "Needs %@ to edit": {
      "comment": "Project card warning. %@ = missing space, e.g. 0.2 GB (SPEC § 14.1, § 15)."
    },
    "Needs %@ to export": {
      "comment": "Project card warning. %@ = missing space, e.g. 0.2 GB (SPEC § 15)."
    },
    "OK": {
      "comment": "Dismisses an alert."
    },
    "Photos": {
      "comment": "Import source: the Photos library."
    },
    "Preparing…": {
      "comment": "Import progress before copying starts."
    },
    "Projects": {
      "comment": "Tab bar item and title of the projects screen."
    },
    "Projects couldn’t be loaded. Restart Echo Engine to try again.": {
      "comment": "Error alert."
    },
    "Record": {
      "comment": "Tab bar item and title of the record screen."
    },
    "Rename": {
      "comment": "Rename action for a project."
    },
