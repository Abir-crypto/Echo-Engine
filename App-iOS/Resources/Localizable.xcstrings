{
  "sourceLanguage": "en",
  "strings": {
    "%@ LUFS": {
      "comment": "A loudness target, e.g. -14 LUFS."
    },
    "%@ dB": {
      "comment": "A level in decibels, e.g. +2.5 dB."
    },
    "%@:1": {
      "comment": "A compression ratio, e.g. 3:1."
    },
    "%lld semitones higher": {
      "comment": "VoiceOver value of the pitch slider. %lld = semitones.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld semitone higher"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld semitones higher"
                }
              }
            }
          }
        }
      }
    },
    "%lld semitones lower": {
      "comment": "VoiceOver value of the pitch slider. %lld = semitones.",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld semitone lower"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld semitones lower"
                }
              }
            }
          }
        }
      }
    },
    "Adds the sound of a room.": {
      "comment": "Effects: explanation under the Reverb switch."
    },
    "Adjust": {
      "comment": "Editor section title for the live manual controls."
    },
    "Adjusted": {
      "comment": "VoiceOver value of the Equalizer row when any band is boosted or cut."
    },
    "Advanced": {
      "comment": "Row that reveals timing and range controls of a dynamics section."
    },
    "Always on: peaks never go above the ceiling.": {
      "comment": "Gain and dynamics: caption under the limiter ceiling slider."
    },
    "Amount": {
      "comment": "De-esser: how strongly sibilance is reduced (slider)."
    },
    "Attack": {
      "comment": "Gate/compressor: how fast it reacts (slider, milliseconds)."
    },
    "Audio": {
      "comment": "Accessibility label of the audio badge on a project card."
    },
    "Band %lld, %@": {
      "comment": "VoiceOver label of an EQ band. %1$lld = band number, %2$@ = its frequency, e.g. Band 3, 1 kHz."
    },
    "Cancel": {
      "comment": "Cancel button."
    },
    "Can’t import": {
      "comment": "Title of the import sheet when an import fails."
    },
    "Changes couldn’t be saved. Free up some space, then try again.": {
      "comment": "Editor error."
    },
    "Collapsed": {
      "comment": "VoiceOver value of the closed Advanced row."
    },
    "Compressor": {
      "comment": "Gain and dynamics: section and switch title."
    },
    "Damping": {
      "comment": "Reverb: how quickly high frequencies fade in the room (slider)."
    },
    "De-esser": {
      "comment": "Gain and dynamics: section and switch title (reduces harsh s sounds)."
    },
    "Delete": {
      "comment": "Delete action for a project."
    },
    "Delete project": {
      "comment": "Destructive confirmation button."
    },
    "Delete “%@”?": {
      "comment": "Delete confirmation title. %@ = project title."
    },
    "Done": {
      "comment": "Closes a sheet; changes are already applied."
    },
    "Edited today": {
      "comment": "Project card date when the project changed today."
    },
    "Effects": {
      "comment": "Editor Adjust row and sheet title: pitch shift and reverb."
    },
    "Equalizer": {
      "comment": "Editor Adjust row and sheet title."
    },
    "Evens out loud and quiet parts.": {
      "comment": "Gain and dynamics: explanation under the Compressor switch."
    },
    "Expanded": {
      "comment": "VoiceOver value of the open Advanced row."
    },
    "Export": {
      "comment": "Editor toolbar button that opens the export sheet."
    },
    "Files": {
      "comment": "Import source: the Files app."
    },
    "Flat": {
      "comment": "VoiceOver value of the Equalizer row when no band is changed."
    },
    "Frequency": {
      "comment": "EQ band / de-esser frequency slider."
    },
    "Gain": {
      "comment": "EQ band gain slider (boost or cut in dB)."
    },
    "Gain and dynamics": {
      "comment": "Editor Adjust row and sheet title: input gain, gate, compressor, de-esser, limiter."
    },
    "High": {
      "comment": "EQ band chip: the high shelf band."
    },
    "High shelf": {
      "comment": "EQ band type shown above its sliders."
    },
    "Hold for original": {
      "comment": "Editor: press and hold to hear the original audio."
